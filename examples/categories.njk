---
pagination:
  data: examples.categories
  size: 1
  alias: category
permalink: "/{{ category.id }}/"
layout: category.njk
eleventyComputed:
  title: "{{ category.title }}"
---
<header class="wa-stack wa-gap-xs">
  <h1 style="margin: 0;">{{ category.title }}</h1>
  {% if category.introHtml %}<div class="category-intro">{{ category.introHtml | safe }}</div>{% endif %}
</header>

{% for ex in category.examples %}
{% if ex.heading %}
<h2 class="category-group" id="{{ ex.heading | slugify }}">{{ ex.heading }}</h2>
{% else %}
<section class="wa-example">
  <div class="wa-example__header">
    <h3 class="wa-example__title">{{ ex.title }}</h3>
    {% if ex.descriptionHtml %}<p class="wa-example__description">{{ ex.descriptionHtml | safe }}</p>{% endif %}
  </div>
  <div class="wa-example__code">{{ ex.codeHtml | safe }}</div>
  <div class="wa-example__preview">{{ ex.renderedHtml | safe }}</div>
</section>
{% endif %}
{% endfor %}
